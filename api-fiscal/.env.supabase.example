# Copie estes valores para o .env da instalação na VPS, preservando CERT_ENCRYPTION_KEY.
# Host, usuário e senha vêm de Connect no projeto Supabase, não das chaves anon/service_role.
STORAGE_DRIVER=pgsql
STORAGE_NAMESPACE=fiscal
DATABASE_SCHEMA=fiscal_private
DATABASE_CONNECTION_MODE=session
DATABASE_REQUIRE_TLS=true
DATABASE_DSN="pgsql:host=HOST_DO_SESSION_POOLER;port=5432;dbname=postgres;sslmode=verify-full;sslrootcert=/app/secrets/supabase-ca.crt"
DATABASE_USER=postgres.REFERENCIA_DO_PROJETO
DATABASE_PASSWORD=PREENCHER_NO_SERVIDOR
CENTRAL_AUTH=true
APP_URL=https://api.seudominio.com.br
SESSION_COOKIE_SECURE=true
XML_STORAGE=s3
S3_ENDPOINT=https://s3.us-east-005.backblazeb2.com
S3_REGION=us-east-005
S3_BUCKET=emissor
S3_ACCESS_KEY_ID=PREENCHER_NO_SERVIDOR
S3_SECRET_ACCESS_KEY=PREENCHER_NO_SERVIDOR
S3_PREFIX=fiscal
S3_SSE=true
S3_TIMEOUT=20
