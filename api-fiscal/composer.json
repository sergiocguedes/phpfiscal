{
  "name": "clickpdv/api-fiscal",
  "description": "API local NF-e, NFC-e e NFS-e para PDV Delphi, com painel de configuração por empresa",
  "type": "project",
  "license": "proprietary",
  "require": {
    "php": ">=8.1",
    "nfephp-org/sped-da": "^1.1",
    "nfephp-org/sped-nfe": "^5.2",
    "phpmailer/phpmailer": "6.11.1"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.5"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "config": {
    "sort-packages": true,
    "platform-check": false
  },
  "scripts": {
    "post-install-cmd": [
      "@php bin/install.php"
    ],
    "test": "@php vendor/bin/phpunit"
  }
}
