# Configuração da API Fiscal. Execute php bin/install.php para gerar os segredos.
API_KEY=
CENTRAL_AUTH=true
STORAGE_DRIVER=pgsql
STORAGE_NAMESPACE=fiscal
DATABASE_DSN=pgsql:host=db;port=5432;dbname=fiscal
DATABASE_USER=fiscal
DATABASE_PASSWORD=
DATABASE_SCHEMA=public
DATABASE_CONNECTION_MODE=direct
DATABASE_REQUIRE_TLS=false
XML_STORAGE=local
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PREFIX=fiscal
S3_SSE=true
S3_TIMEOUT=20
CERT_ENCRYPTION_KEY=
NFCE_CONTINGENCIA_UFS=
AUTH_MAX_FAILURES=10
AUTH_WINDOW_SECONDS=300
AUTH_BLOCK_SECONDS=900
HOST=127.0.0.1
PORT=8081
TRUSTED_PROXIES=
APP_URL=http://localhost:8081
SESSION_COOKIE_SECURE=false
SESSION_IDLE_SECONDS=1800
SESSION_ABSOLUTE_SECONDS=43200
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_SECONDS=900
LOGIN_IP_MAX=20
SIGNUP_IP_MAX=5
FORGOT_IP_MAX=5
MAIL_DEV_LOG=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=tls
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@localhost
SMTP_FROM_NAME=Emissor NF-e
MFA_OBRIGATORIO_DONO=false
# Margem de dhEmi: 30..300 segundos. Corrija também a sincronização do relógio do host.
NFSE_DHEMI_RECUO_SEGUNDOS=30
NFSE_RATE_MAX=60
NFSE_TIMEOUT=60
NFSE_DANFSE_TIMEOUT=8
NFSE_DANFSE_PAUSA_ADN=300
PERMITIR_MULTIPART=false
ACEITAR_PHP_VULNERAVEL=false
