# Dados de INICIALIZAÇÃO — os únicos que ficam fora do banco.
# Na VPS eles vão para /etc/phpfiscal/bootstrap.env (deploy/instalar-vps.sh); este arquivo é para uso local.
# Todo o resto (URL, SMTP, sessões, limites, NFS-e...) é configurado em /configuracao e fica cifrado no banco.
DATABASE_DSN=pgsql:host=db;port=5432;dbname=fiscal
DATABASE_USER=fiscal
DATABASE_PASSWORD=
# Chave-mestra (base64 de 32 bytes): cifra certificados A1 e a configuração. Perder = perder esses dados.
CERT_ENCRYPTION_KEY=
