# Complementa .env.example. Gere o arquivo completo com bin/preparar-perfil.php local.
CENTRAL_AUTH=true
STORAGE_DRIVER=pgsql
STORAGE_NAMESPACE=fiscal_local
DATABASE_DSN="pgsql:host=db;port=5432;dbname=fiscal"
DATABASE_USER=fiscal
DATABASE_PASSWORD=
DATABASE_SCHEMA=public
DATABASE_CONNECTION_MODE=direct
DATABASE_REQUIRE_TLS=false
XML_STORAGE=local
APP_URL=http://localhost:8081
SESSION_COOKIE_SECURE=false
